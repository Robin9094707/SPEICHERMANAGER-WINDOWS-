<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Simplex.Pages.GamesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Simplex.ViewModels"
    NavigationCacheMode="Required"
    Background="Transparent">

    <Grid Padding="36,24,36,24" RowSpacing="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Spiele" Style="{StaticResource PageTitle}" />
            <TextBlock Text="Installierte Spiele von Steam, Epic, GOG, Ubisoft, EA, Battle.net, Riot, Rockstar und Xbox – nach Größe sortiert."
                       Style="{StaticResource SecondaryText}" FontSize="14" TextWrapping="Wrap" />
        </StackPanel>

        <Grid Grid.Row="1">
            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <TextBlock x:Name="SummaryText" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
                <ProgressRing x:Name="Busy" Width="18" Height="18" IsActive="False" />
            </StackPanel>
            <Button HorizontalAlignment="Right" Click="Refresh_Click">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE72C;" FontSize="14" />
                    <TextBlock Text="Neu einlesen" />
                </StackPanel>
            </Button>
        </Grid>

        <InfoBar x:Name="Info" Grid.Row="2" IsOpen="False" />

        <Border Grid.Row="3" Style="{StaticResource CardStyle}" Padding="4">
            <Grid>
                <ListView x:Name="GameList" SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:GameItem">
                            <Grid Padding="0,10" ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="200" />
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Width="40" Height="40" CornerRadius="8" Background="{ThemeResource AccentFillColorDefaultBrush}">
                                    <TextBlock Text="{x:Bind Initial}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="18" FontWeight="SemiBold"
                                               Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind Name}" Style="{StaticResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Style="{StaticResource SecondaryText}">
                                        <Run Text="{x:Bind Launcher}" /><Run Text=" · " /><Run Text="{x:Bind InstallPath}" />
                                    </TextBlock>
                                </StackPanel>
                                <ProgressBar Grid.Column="2" Value="{x:Bind Percent, Mode=OneWay}" Maximum="100" Height="6" MinHeight="6" CornerRadius="3" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="3" Text="{x:Bind SizeText, Mode=OneWay}" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <Button Tag="{x:Bind}" Click="Open_Click" ToolTipService.ToolTip="Ordner öffnen">
                                        <FontIcon Glyph="&#xE838;" FontSize="14" />
                                    </Button>
                                    <Button Tag="{x:Bind}" Click="Uninstall_Click" Visibility="{x:Bind UninstallVisibility}" Content="Deinstallieren" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <TextBlock x:Name="EmptyText" Text="Keine Spiele gefunden." Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource SecondaryText}" FontSize="14" />
            </Grid>
        </Border>
    </Grid>
</Page>
