<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Simplex.Pages.ProgramsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Simplex.ViewModels"
    NavigationCacheMode="Required"
    Background="Transparent">

    <Grid Padding="36,24,36,24" RowSpacing="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Programme" Style="{StaticResource PageTitle}" />
            <TextBlock Text="Alle installierten Desktop-Programme nach Größe. Nicht mehr benötigte Programme direkt deinstallieren."
                       Style="{StaticResource SecondaryText}" FontSize="14" TextWrapping="Wrap" />
        </StackPanel>

        <Grid Grid.Row="1" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <AutoSuggestBox x:Name="SearchBox" PlaceholderText="Programme durchsuchen…" QueryIcon="Find" Width="300" TextChanged="SearchBox_TextChanged" />
                <TextBlock x:Name="SummaryText" Style="{StaticResource SecondaryText}" VerticalAlignment="Center" />
                <ProgressRing x:Name="Busy" Width="18" Height="18" IsActive="False" />
            </StackPanel>
            <ComboBox x:Name="SortCombo" Grid.Column="1" MinWidth="160" SelectionChanged="SortCombo_SelectionChanged">
                <ComboBoxItem Content="Größte zuerst" />
                <ComboBoxItem Content="Name A–Z" />
                <ComboBoxItem Content="Neueste zuerst" />
            </ComboBox>
            <Button Grid.Column="2" Click="Refresh_Click" ToolTipService.ToolTip="Neu einlesen">
                <FontIcon Glyph="&#xE72C;" FontSize="14" />
            </Button>
            <Button Grid.Column="3" Content="Windows-Apps-Einstellungen" Click="Settings_Click" />
        </Grid>

        <InfoBar x:Name="Info" Grid.Row="2" IsOpen="False" />

        <Border Grid.Row="3" Style="{StaticResource CardStyle}" Padding="4">
            <ListView x:Name="ProgramList" SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:ProgramItem">
                        <Grid Padding="0,10" ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="36" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Width="36" Height="36" CornerRadius="8" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                <TextBlock Text="{x:Bind Initial}" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind Name}" Style="{StaticResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{x:Bind Details}" Style="{StaticResource SecondaryText}" />
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="{x:Bind SizeText, Mode=OneWay}" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <Button Tag="{x:Bind}" Click="Open_Click" IsEnabled="{x:Bind HasLocation}" ToolTipService.ToolTip="Installationsordner öffnen">
                                    <FontIcon Glyph="&#xE838;" FontSize="14" />
                                </Button>
                                <Button Tag="{x:Bind}" Click="Uninstall_Click" Content="Deinstallieren" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Border>
    </Grid>
</Page>
