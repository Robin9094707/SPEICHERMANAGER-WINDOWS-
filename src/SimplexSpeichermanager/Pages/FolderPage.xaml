<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Simplex.Pages.FolderPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Simplex.ViewModels"
    NavigationCacheMode="Required"
    Background="Transparent">

    <Grid Padding="36,24,36,24" RowSpacing="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Ordneranalyse" Style="{StaticResource PageTitle}" />
            <TextBlock Text="Sehen Sie, welche Ordner am meisten Platz belegen. Doppelklick öffnet einen Ordner."
                       Style="{StaticResource SecondaryText}" FontSize="14" />
        </StackPanel>

        <Grid Grid.Row="1" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button x:Name="UpButton" Click="Up_Click" ToolTipService.ToolTip="Eine Ebene nach oben" IsEnabled="False">
                <FontIcon Glyph="&#xE74A;" FontSize="16" />
            </Button>
            <BreadcrumbBar x:Name="Crumbs" Grid.Column="1" VerticalAlignment="Center" ItemClicked="Crumbs_ItemClicked" />
            <Button Grid.Column="2" Click="OpenExplorer_Click" ToolTipService.ToolTip="Im Explorer öffnen">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE838;" FontSize="14" />
                    <TextBlock Text="Explorer" />
                </StackPanel>
            </Button>
            <Button x:Name="DeleteButton" Grid.Column="3" Click="Delete_Click" IsEnabled="False" Style="{StaticResource AccentButtonStyle}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE74D;" FontSize="14" />
                    <TextBlock Text="Ordner löschen" />
                </StackPanel>
            </Button>
        </Grid>

        <TextBlock x:Name="SummaryText" Grid.Row="2" Style="{StaticResource BodyStrongTextBlockStyle}" />
        <InfoBar x:Name="Info" Grid.Row="3" IsOpen="False" />

        <Border Grid.Row="4" Style="{StaticResource CardStyle}" Padding="4">
            <Grid>
                <ListView x:Name="FolderList" SelectionMode="Single" IsItemClickEnabled="False"
                          SelectionChanged="FolderList_SelectionChanged" DoubleTapped="FolderList_DoubleTapped">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:FolderItem">
                            <Grid Padding="0,8" ColumnSpacing="14" Background="Transparent">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="220" />
                                    <ColumnDefinition Width="100" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Glyph="{x:Bind Glyph}" FontSize="20" VerticalAlignment="Center" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                                        <Border Style="{StaticResource BadgeStyle}" Visibility="{x:Bind HiddenVisibility}" Background="{ThemeResource SubtleFillColorTertiaryBrush}" Padding="5,0">
                                            <TextBlock Text="Versteckt" FontSize="11" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{x:Bind DetailText}" Style="{StaticResource SecondaryText}" />
                                </StackPanel>
                                <Grid Grid.Column="2" ColumnSpacing="8" VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="52" />
                                    </Grid.ColumnDefinitions>
                                    <ProgressBar Value="{x:Bind Percent}" Maximum="100" Height="6" MinHeight="6" CornerRadius="3" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind PercentText}" HorizontalAlignment="Right" Style="{StaticResource SecondaryText}" />
                                </Grid>
                                <TextBlock Grid.Column="3" Text="{x:Bind SizeText}" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12" Padding="24">
                    <FontIcon Glyph="&#xE8B7;" FontSize="48" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    <TextBlock Text="Noch keine Daten. Starten Sie zuerst einen Scan." HorizontalAlignment="Center" Style="{StaticResource SecondaryText}" FontSize="14" />
                    <Button Content="Zum Scan" HorizontalAlignment="Center" Style="{StaticResource AccentButtonStyle}" Click="GoScan_Click" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>
