<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Simplex.Pages.ScanPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Simplex.ViewModels"
    NavigationCacheMode="Required"
    Background="Transparent">

    <Grid Padding="36,24,36,24" RowSpacing="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Große Dateien finden" Style="{StaticResource PageTitle}" />
            <TextBlock Text="Durchsucht Ihre Laufwerke parallel auf allen Prozessorkernen – auch versteckte Dateien. Systemdateien werden erkannt und geschützt."
                       Style="{StaticResource SecondaryText}" FontSize="14" TextWrapping="Wrap" />
        </StackPanel>

        <!-- Konfiguration -->
        <Border x:Name="ConfigCard" Grid.Row="1" Style="{StaticResource CardStyle}">
            <Grid RowSpacing="16" ColumnSpacing="24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <RadioButtons x:Name="ModeRadio" Header="Scan-Modus" MaxColumns="4" SelectionChanged="ModeRadio_SelectionChanged">
                    <RadioButton Content="Schnell – Benutzerordner" />
                    <RadioButton Content="Ein Laufwerk" />
                    <RadioButton Content="Alle Laufwerke" />
                    <RadioButton Content="Eigener Ordner" />
                </RadioButtons>

                <Grid Grid.Row="1" ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="QuickHint" VerticalAlignment="Bottom" Margin="0,0,0,6" Style="{StaticResource SecondaryText}" TextWrapping="Wrap" />
                    <ComboBox x:Name="DriveCombo" Header="Laufwerk" HorizontalAlignment="Stretch" Visibility="Collapsed" />
                    <Grid x:Name="FolderPanel" ColumnSpacing="8" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="FolderBox" Header="Ordner" PlaceholderText="z. B. D:\Videos" />
                        <Button Grid.Column="1" Content="Durchsuchen…" VerticalAlignment="Bottom" Click="Browse_Click" />
                    </Grid>
                    <ComboBox x:Name="MinSizeCombo" Grid.Column="1" Header="Mindestgröße" HorizontalAlignment="Stretch">
                        <ComboBoxItem Content="ab 10 MB" />
                        <ComboBoxItem Content="ab 50 MB" />
                        <ComboBoxItem Content="ab 100 MB" />
                        <ComboBoxItem Content="ab 500 MB" />
                        <ComboBoxItem Content="ab 1 GB" />
                        <ComboBoxItem Content="ab 5 GB" />
                    </ComboBox>
                    <ComboBox x:Name="PerfCombo" Grid.Column="2" Header="Leistung" HorizontalAlignment="Stretch" />
                </Grid>

                <Grid Grid.Row="2" ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <CheckBox x:Name="HiddenCheck" Content="Versteckte Dateien einbeziehen" />
                    <CheckBox x:Name="ProtectedCheck" Grid.Column="1" Content="Geschützte Systemdateien ausblenden" Click="Filter_Click" />
                    <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8">
                        <Button x:Name="CancelButton" Content="Abbrechen" IsEnabled="False" Click="Cancel_Click" />
                        <Button x:Name="StartButton" Style="{StaticResource AccentButtonStyle}" Click="Start_Click" MinWidth="150">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE721;" FontSize="14" />
                                <TextBlock Text="Scan starten" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- Fortschritt -->
        <Border x:Name="ProgressCard" Grid.Row="2" Style="{StaticResource CardStyle}" Visibility="Collapsed">
            <StackPanel Spacing="10">
                <Grid>
                    <TextBlock x:Name="ProgressTitle" Text="Scan läuft…" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock x:Name="ElapsedText" HorizontalAlignment="Right" Style="{StaticResource SecondaryText}" />
                </Grid>
                <ProgressBar x:Name="ScanProgressBar" IsIndeterminate="True" />
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel><TextBlock Text="Dateien" Style="{StaticResource SecondaryText}" /><TextBlock x:Name="StatFiles" Style="{StaticResource BodyStrongTextBlockStyle}" /></StackPanel>
                    <StackPanel Grid.Column="1"><TextBlock Text="Ordner" Style="{StaticResource SecondaryText}" /><TextBlock x:Name="StatDirs" Style="{StaticResource BodyStrongTextBlockStyle}" /></StackPanel>
                    <StackPanel Grid.Column="2"><TextBlock Text="Datenmenge" Style="{StaticResource SecondaryText}" /><TextBlock x:Name="StatBytes" Style="{StaticResource BodyStrongTextBlockStyle}" /></StackPanel>
                    <StackPanel Grid.Column="3"><TextBlock Text="Tempo" Style="{StaticResource SecondaryText}" /><TextBlock x:Name="StatRate" Style="{StaticResource BodyStrongTextBlockStyle}" /></StackPanel>
                    <StackPanel Grid.Column="4"><TextBlock Text="Große Dateien" Style="{StaticResource SecondaryText}" /><TextBlock x:Name="StatFound" Style="{StaticResource BodyStrongTextBlockStyle}" /></StackPanel>
                </Grid>
                <TextBlock x:Name="CurrentPathText" Style="{StaticResource SecondaryText}" />
            </StackPanel>
        </Border>

        <InfoBar x:Name="Info" Grid.Row="3" IsOpen="False" />

        <!-- Werkzeugleiste -->
        <Grid x:Name="Toolbar" Grid.Row="4" ColumnSpacing="10" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <AutoSuggestBox x:Name="SearchBox" PlaceholderText="Ergebnisse durchsuchen…" QueryIcon="Find" TextChanged="SearchBox_TextChanged" MaxWidth="420" HorizontalAlignment="Left" MinWidth="220" />
            <ComboBox x:Name="CategoryCombo" Grid.Column="1" MinWidth="230" SelectionChanged="Filter_SelectionChanged" />
            <ComboBox x:Name="SortCombo" Grid.Column="2" MinWidth="170" SelectionChanged="Filter_SelectionChanged">
                <ComboBoxItem Content="Größte zuerst" />
                <ComboBoxItem Content="Älteste zuerst" />
                <ComboBoxItem Content="Name A–Z" />
            </ComboBox>
            <Button Grid.Column="3" Click="OpenSelected_Click" ToolTipService.ToolTip="Im Explorer anzeigen">
                <FontIcon Glyph="&#xE838;" FontSize="16" />
            </Button>
            <Button x:Name="DeleteButton" Grid.Column="4" Style="{StaticResource AccentButtonStyle}" Click="DeleteSelected_Click" IsEnabled="False">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE74D;" FontSize="14" />
                    <TextBlock x:Name="DeleteButtonText" Text="Löschen" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- Ergebnisliste -->
        <Border Grid.Row="5" Style="{StaticResource CardStyle}" Padding="4">
            <Grid>
                <ListView x:Name="ResultList" SelectionMode="Multiple" SelectionChanged="ResultList_SelectionChanged">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:FileItem">
                            <Grid Padding="0,8" ColumnSpacing="14" Opacity="{x:Bind ContentOpacity}" Background="Transparent">
                                <Grid.ContextFlyout>
                                    <MenuFlyout>
                                        <MenuFlyoutItem Text="Im Explorer anzeigen" Tag="{x:Bind}" Click="ItemShow_Click">
                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE838;" /></MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem Text="Pfad kopieren" Tag="{x:Bind}" Click="ItemCopy_Click">
                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8C8;" /></MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutSeparator />
                                        <MenuFlyoutItem Text="Löschen…" Tag="{x:Bind}" Click="ItemDelete_Click">
                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE74D;" /></MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                    </MenuFlyout>
                                </Grid.ContextFlyout>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="90" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Glyph="{x:Bind Glyph}" FontSize="20" VerticalAlignment="Center" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{x:Bind Directory}" Style="{StaticResource SecondaryText}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <Border Style="{StaticResource BadgeStyle}" Visibility="{x:Bind HiddenVisibility}" Background="{ThemeResource SubtleFillColorTertiaryBrush}">
                                        <TextBlock Text="Versteckt" FontSize="11" />
                                    </Border>
                                    <Border Style="{StaticResource BadgeStyle}" Visibility="{x:Bind CautionVisibility}" Background="{ThemeResource SystemFillColorCautionBackgroundBrush}" ToolTipService.ToolTip="{x:Bind SafetyReason}">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <FontIcon Glyph="&#xE7BA;" FontSize="11" Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                                            <TextBlock Text="Vorsicht" FontSize="11" />
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource BadgeStyle}" Visibility="{x:Bind ProtectedVisibility}" Background="{ThemeResource SystemFillColorCriticalBackgroundBrush}" ToolTipService.ToolTip="{x:Bind SafetyReason}">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <FontIcon Glyph="&#xEA18;" FontSize="11" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                                            <TextBlock Text="Geschützt" FontSize="11" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                                <TextBlock Grid.Column="3" Text="{x:Bind SizeText}" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock Grid.Column="4" Text="{x:Bind DateText}" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource SecondaryText}" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12" Padding="24">
                    <FontIcon Glyph="&#xE721;" FontSize="48" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    <TextBlock x:Name="EmptyText" Text="Wählen Sie einen Scan-Modus und starten Sie den Scan." HorizontalAlignment="Center" Style="{StaticResource SecondaryText}" FontSize="14" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>
