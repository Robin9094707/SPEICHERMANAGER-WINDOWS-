<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Simplex.Pages.LeftoversPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Simplex.ViewModels"
    NavigationCacheMode="Required"
    Background="Transparent">

    <Grid Padding="36,24,36,24" RowSpacing="14" ColumnSpacing="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="320" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.ColumnSpan="2">
            <TextBlock x:Name="TitleText" Text="Reste-Finder" Style="{StaticResource PageTitle}" />
            <TextBlock x:Name="SubtitleText" Style="{StaticResource SecondaryText}" FontSize="14" TextWrapping="Wrap" TextTrimming="None"
                       Text="Findet Überbleibsel von Programmen, die früher entfernt wurden – auch mit anderen Tools: verwaiste Ordner, tote Verknüpfungen, alte Registry-Schlüssel, Dienste und Aufgaben ohne Programm." />
        </StackPanel>

        <!-- Werkzeugleiste -->
        <Grid x:Name="Toolbar" Grid.Row="1" ColumnSpacing="10" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <AutoSuggestBox x:Name="SearchBox" PlaceholderText="Reste durchsuchen…" QueryIcon="Find" Width="260" TextChanged="SearchBox_TextChanged" />
                <TextBlock x:Name="CountText" Style="{StaticResource SecondaryText}" VerticalAlignment="Center" />
            </StackPanel>
            <ComboBox x:Name="FilterCombo" Grid.Column="1" MinWidth="180" SelectionChanged="Filter_SelectionChanged">
                <ComboBoxItem Content="Alle Funde" />
                <ComboBoxItem Content="Nur „Sicher“" />
                <ComboBoxItem Content="Nur Dateien &amp; Ordner" />
                <ComboBoxItem Content="Nur Registry" />
                <ComboBoxItem Content="Nur „Prüfen“" />
            </ComboBox>
            <DropDownButton Grid.Column="2" Content="Auswahl">
                <DropDownButton.Flyout>
                    <MenuFlyout Placement="Bottom">
                        <MenuFlyoutItem Text="Empfohlene auswählen (Sicher + Wahrscheinlich)" Click="SelectRecommended_Click" />
                        <MenuFlyoutItem Text="Nur „Sicher“ auswählen" Click="SelectHigh_Click" />
                        <MenuFlyoutItem Text="Alle sichtbaren auswählen" Click="SelectAll_Click" />
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem Text="Auswahl aufheben" Click="SelectNone_Click" />
                    </MenuFlyout>
                </DropDownButton.Flyout>
            </DropDownButton>
            <Button Grid.Column="3" Click="NewScan_Click" ToolTipService.ToolTip="PC erneut nach Altlasten durchsuchen">
                <FontIcon Glyph="&#xE72C;" FontSize="14" />
            </Button>
        </Grid>

        <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Spacing="8">
            <InfoBar x:Name="AdminInfo" IsOpen="False" Severity="Warning" IsClosable="True" Title="Einige Reste brauchen Adminrechte">
                <InfoBar.ActionButton>
                    <Button Content="Als Administrator neu starten" Click="Admin_Click" />
                </InfoBar.ActionButton>
            </InfoBar>
            <InfoBar x:Name="Info" IsOpen="False" />
        </StackPanel>

        <!-- Startansicht -->
        <Border x:Name="IntroCard" Grid.Row="3" Style="{StaticResource CardStyle}" Padding="40">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="16" MaxWidth="560">
                <FontIcon Glyph="&#xE74D;" FontSize="56" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                <TextBlock Text="Was ist von alten Programmen übrig?" Style="{StaticResource SubtitleTextBlockStyle}" HorizontalAlignment="Center" TextAlignment="Center" />
                <TextBlock Style="{StaticResource SecondaryText}" TextWrapping="Wrap" TextTrimming="None" TextAlignment="Center" FontSize="14"
                           Text="Simplex gleicht Programme, Store-Apps, Spiele, Dienste und laufende Prozesse mit allen Ordnern in „Programme“, ProgramData und AppData ab und prüft Registry, Startmenü, Autostart, geplante Aufgaben und Firewall. Alles, was zu keinem installierten Programm mehr gehört, wird angezeigt – gelöscht wird nur, was Sie auswählen." />
                <Button x:Name="ScanButton" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Center" Padding="24,10" Click="NewScan_Click">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon Glyph="&#xE721;" FontSize="16" />
                        <TextBlock Text="PC nach Altlasten durchsuchen" FontSize="15" />
                    </StackPanel>
                </Button>
                <StackPanel x:Name="ScanProgress" Spacing="8" Visibility="Collapsed" HorizontalAlignment="Stretch">
                    <ProgressBar IsIndeterminate="True" />
                    <TextBlock x:Name="ScanText" Style="{StaticResource SecondaryText}" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Ergebnisliste -->
        <Border x:Name="ListCard" Grid.Row="3" Style="{StaticResource CardStyle}" Padding="4" Visibility="Collapsed">
            <Grid>
                <ListView x:Name="ResultList" SelectionMode="None">
                    <ListView.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate x:DataType="vm:LeftoverGroup">
                                    <TextBlock Text="{x:Bind Header}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ListView.GroupStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:LeftoverVm">
                            <Grid Padding="0,8" ColumnSpacing="12" Opacity="{x:Bind ItemOpacity}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="24" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <CheckBox IsChecked="{x:Bind IsChecked, Mode=TwoWay}" IsEnabled="{x:Bind CanRun}" MinWidth="0" VerticalAlignment="Center" />
                                <FontIcon Grid.Column="1" Glyph="{x:Bind Glyph}" FontSize="18" VerticalAlignment="Center" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Title}" />
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Border Style="{StaticResource BadgeStyle}" Padding="6,0" Visibility="{x:Bind HighVisibility}" Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}">
                                            <TextBlock Text="{x:Bind ConfidenceText}" FontSize="11" />
                                        </Border>
                                        <Border Style="{StaticResource BadgeStyle}" Padding="6,0" Visibility="{x:Bind MediumVisibility}" Background="{ThemeResource SystemFillColorAttentionBackgroundBrush}">
                                            <TextBlock Text="{x:Bind ConfidenceText}" FontSize="11" />
                                        </Border>
                                        <Border Style="{StaticResource BadgeStyle}" Padding="6,0" Visibility="{x:Bind LowVisibility}" Background="{ThemeResource SystemFillColorCautionBackgroundBrush}">
                                            <TextBlock Text="{x:Bind ConfidenceText}" FontSize="11" />
                                        </Border>
                                        <Border Style="{StaticResource BadgeStyle}" Padding="6,0" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                            <TextBlock Text="{x:Bind Owner}" FontSize="11" MaxWidth="220" TextTrimming="CharacterEllipsis" />
                                        </Border>
                                        <Border Style="{StaticResource BadgeStyle}" Padding="6,0" Visibility="{x:Bind AdminVisibility}" Background="{ThemeResource SystemFillColorCautionBackgroundBrush}">
                                            <TextBlock Text="Admin nötig" FontSize="11" />
                                        </Border>
                                        <TextBlock Text="{x:Bind Reason}" Style="{StaticResource SecondaryText}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </StackPanel>
                                <TextBlock Grid.Column="3" Text="{x:Bind SizeText}" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <Button Grid.Column="4" Tag="{x:Bind}" Click="Locate_Click" VerticalAlignment="Center" ToolTipService.ToolTip="Im Explorer bzw. in der Registry anzeigen">
                                    <FontIcon Glyph="&#xE8A7;" FontSize="14" />
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <TextBlock x:Name="EmptyText" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource SecondaryText}" FontSize="14"
                           Text="Keine Reste gefunden – alles sauber! ✨" />
            </Grid>
        </Border>

        <!-- Seitenleiste -->
        <ScrollViewer Grid.Row="3" Grid.Column="1">
            <StackPanel Spacing="16">
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Ausgewählt zum Entfernen" Style="{StaticResource SecondaryText}" />
                        <TextBlock x:Name="TotalText" Text="–" FontSize="34" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <TextBlock x:Name="TotalHint" Text="Noch keine Suche durchgeführt." Style="{StaticResource SecondaryText}" TextWrapping="Wrap" TextTrimming="None" />
                        <Button x:Name="DeleteButton" HorizontalAlignment="Stretch" Style="{StaticResource AccentButtonStyle}" Click="Delete_Click" IsEnabled="False">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE74D;" FontSize="14" />
                                <TextBlock Text="Ausgewählte Reste löschen" />
                            </StackPanel>
                        </Button>
                        <StackPanel x:Name="DeleteProgress" Spacing="6" Visibility="Collapsed">
                            <ProgressBar x:Name="DeleteBar" Minimum="0" Maximum="1" />
                            <TextBlock x:Name="DeleteText" Style="{StaticResource SecondaryText}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Bewertung" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Border Style="{StaticResource BadgeStyle}" Padding="6,0" Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}"><TextBlock Text="Sicher" FontSize="11" /></Border>
                            <TextBlock Text="gehört eindeutig zum Programm" Style="{StaticResource SecondaryText}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Border Style="{StaticResource BadgeStyle}" Padding="6,0" Background="{ThemeResource SystemFillColorAttentionBackgroundBrush}"><TextBlock Text="Wahrscheinlich" FontSize="11" /></Border>
                            <TextBlock Text="Name passt, lange unbenutzt" Style="{StaticResource SecondaryText}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Border Style="{StaticResource BadgeStyle}" Padding="6,0" Background="{ThemeResource SystemFillColorCautionBackgroundBrush}"><TextBlock Text="Prüfen" FontSize="11" /></Border>
                            <TextBlock Text="nicht vorausgewählt" Style="{StaticResource SecondaryText}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Sicherheitsnetz" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock Style="{StaticResource SecondaryText}" TextWrapping="Wrap" TextTrimming="None"
                                   Text="Vor jedem Löschen wird die betroffene Registry als .reg-Datei gesichert (Doppelklick stellt sie wieder her). Dateien können in den Papierkorb verschoben werden. Windows-Ordner, Systemdienste und Microsoft-Bereiche der Registry sind gesperrt." />
                        <HyperlinkButton Content="Sicherungen öffnen" Click="Backups_Click" Padding="0" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
