<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Simplex.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">

    <ScrollViewer>
        <StackPanel Padding="36,24,36,36" Spacing="16" MaxWidth="1000" HorizontalAlignment="Stretch">
            <TextBlock Text="Einstellungen" Style="{StaticResource PageTitle}" />

            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="8">
                    <TextBlock Text="Darstellung" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <RadioButtons x:Name="ThemeRadio" SelectionChanged="Theme_Changed" MaxColumns="3">
                        <RadioButton Content="Systemstandard" />
                        <RadioButton Content="Hell" />
                        <RadioButton Content="Dunkel" />
                    </RadioButtons>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="4">
                        <TextBlock Text="Standardmäßig in den Papierkorb löschen" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock Text="Sicherer, aber der Platz wird erst frei, wenn der Papierkorb geleert wird." Style="{StaticResource SecondaryText}" TextWrapping="Wrap" />
                    </StackPanel>
                    <ToggleSwitch x:Name="RecycleToggle" Grid.Column="1" Toggled="Recycle_Toggled" OnContent="Ein" OffContent="Aus" />
                </Grid>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="4">
                        <TextBlock Text="Administratorrechte" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock x:Name="AdminText" Style="{StaticResource SecondaryText}" TextWrapping="Wrap" />
                    </StackPanel>
                    <Button x:Name="AdminButton" Grid.Column="1" Content="Als Administrator neu starten" Click="Admin_Click" VerticalAlignment="Center" />
                </Grid>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="8">
                    <TextBlock Text="Sicherheit" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock Style="{StaticResource SecondaryText}" TextWrapping="Wrap" TextTrimming="None"
                               Text="Simplex löscht niemals Systemdateien: Der Windows-Ordner, Bootdateien, pagefile.sys, hiberfil.sys, swapfile.sys, Registry-Dateien, die Wiederherstellung, Windows-Sicherheit, Store-Apps sowie alle Dateien mit dem System-Attribut sind gesperrt. Dateien von Programmen, Spielen und App-Daten werden als „Vorsicht“ markiert und erfordern eine Bestätigung. Vor jedem Löschvorgang wird erneut geprüft." />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Image Source="ms-appx:///Assets/AppIcon.png" Width="48" Height="48" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Simplex Speichermanager" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock x:Name="VersionText" Style="{StaticResource SecondaryText}" />
                    </StackPanel>
                    <Button Grid.Column="2" Content="Protokollordner öffnen" Click="Logs_Click" VerticalAlignment="Center" />
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
