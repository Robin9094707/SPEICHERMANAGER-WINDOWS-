<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Simplex.Pages.CleanupPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Simplex.ViewModels"
    NavigationCacheMode="Required"
    Background="Transparent">

    <Grid Padding="36,24,36,24" RowSpacing="14" ColumnSpacing="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="340" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.ColumnSpan="2">
            <TextBlock Text="Bereinigung" Style="{StaticResource PageTitle}" />
            <TextBlock Text="Leert Caches, temporäre Dateien und Papierkorb. Es werden nur Daten gelöscht, die Programme automatisch neu erzeugen – keine persönlichen Dateien."
                       Style="{StaticResource SecondaryText}" FontSize="14" TextWrapping="Wrap" />
        </StackPanel>

        <InfoBar x:Name="Info" Grid.Row="1" Grid.ColumnSpan="2" IsOpen="False" />

        <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="4">
            <ListView x:Name="CleanupList" SelectionMode="None">
                <ListView.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.HeaderTemplate>
                            <DataTemplate x:DataType="vm:CleanupGroup">
                                <TextBlock Text="{x:Bind Key}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            </DataTemplate>
                        </GroupStyle.HeaderTemplate>
                    </GroupStyle>
                </ListView.GroupStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:CleanupItem">
                        <Grid Padding="0,10" ColumnSpacing="12" Opacity="{x:Bind ItemOpacity}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="28" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="110" />
                            </Grid.ColumnDefinitions>
                            <CheckBox IsChecked="{x:Bind IsChecked, Mode=TwoWay}" IsEnabled="{x:Bind CanRun}" MinWidth="0" VerticalAlignment="Center" />
                            <FontIcon Grid.Column="1" Glyph="{x:Bind Glyph}" FontSize="20" VerticalAlignment="Center" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="2">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="{x:Bind Name}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    <Border Style="{StaticResource BadgeStyle}" Visibility="{x:Bind AdminVisibility}" Background="{ThemeResource SystemFillColorCautionBackgroundBrush}" Padding="5,0">
                                        <TextBlock Text="Adminrechte nötig" FontSize="11" />
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="{x:Bind Description}" Style="{StaticResource SecondaryText}" TextWrapping="Wrap" TextTrimming="None" />
                            </StackPanel>
                            <Grid Grid.Column="3" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind SizeText, Mode=OneWay}" HorizontalAlignment="Right" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <ProgressRing IsActive="{x:Bind IsBusy, Mode=OneWay}" Visibility="{x:Bind BusyVisibility, Mode=OneWay}" Width="18" Height="18" HorizontalAlignment="Right" />
                            </Grid>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Border>

        <ScrollViewer Grid.Row="2" Grid.Column="1">
            <StackPanel Spacing="16">
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Ausgewählt zum Bereinigen" Style="{StaticResource SecondaryText}" />
                        <TextBlock x:Name="TotalText" Text="–" FontSize="34" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <TextBlock x:Name="TotalHint" Text="Klicken Sie auf „Analysieren“." Style="{StaticResource SecondaryText}" TextWrapping="Wrap" />
                        <Button x:Name="AnalyzeButton" HorizontalAlignment="Stretch" Click="Analyze_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE721;" FontSize="14" />
                                <TextBlock Text="Analysieren" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="CleanButton" HorizontalAlignment="Stretch" Style="{StaticResource AccentButtonStyle}" Click="Clean_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xEA99;" FontSize="14" />
                                <TextBlock Text="Jetzt bereinigen" />
                            </StackPanel>
                        </Button>
                        <HyperlinkButton x:Name="AdminLink" Content="Als Administrator neu starten" Click="Admin_Click" HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="14">
                        <TextBlock Text="Windows-Werkzeuge" Style="{StaticResource BodyStrongTextBlockStyle}" />

                        <StackPanel Spacing="4">
                            <TextBlock Text="Ruhezustand deaktivieren" />
                            <TextBlock x:Name="HiberText" Style="{StaticResource SecondaryText}" TextWrapping="Wrap" />
                            <Button x:Name="HiberButton" Content="hiberfil.sys entfernen" Click="Hiber_Click" Margin="0,4,0,0" />
                        </StackPanel>

                        <StackPanel Spacing="4">
                            <TextBlock Text="Komponentenspeicher bereinigen" />
                            <TextBlock Text="Entfernt alte, ersetzte Windows-Update-Komponenten aus WinSxS (DISM). Kann einige Minuten dauern."
                                       Style="{StaticResource SecondaryText}" TextWrapping="Wrap" />
                            <Button Content="WinSxS bereinigen" Click="Dism_Click" Margin="0,4,0,0" />
                        </StackPanel>

                        <StackPanel Spacing="4">
                            <TextBlock Text="Weitere Windows-Optionen" />
                            <Button Content="Datenträgerbereinigung öffnen" Click="Cleanmgr_Click" HorizontalAlignment="Stretch" />
                            <Button Content="Speicheroptimierung (Storage Sense)" Click="StorageSense_Click" HorizontalAlignment="Stretch" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
