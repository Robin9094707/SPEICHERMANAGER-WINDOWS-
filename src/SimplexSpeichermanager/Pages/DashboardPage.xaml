<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Simplex.Pages.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Simplex.ViewModels"
    Background="Transparent">

    <ScrollViewer>
        <StackPanel Padding="36,24,36,36" Spacing="20" MaxWidth="1400">
            <StackPanel>
                <TextBlock Text="Übersicht" Style="{StaticResource PageTitle}" />
                <TextBlock x:Name="SubtitleText" Style="{StaticResource SecondaryText}" FontSize="14" />
            </StackPanel>

            <!-- Kennzahlen -->
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Freier Speicher (gesamt)" Style="{StaticResource SecondaryText}" />
                        <TextBlock x:Name="FreeTotalText" Style="{StaticResource SubtitleTextBlockStyle}" FontSize="28" />
                        <TextBlock x:Name="CapacityText" Style="{StaticResource SecondaryText}" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="4">
                        <TextBlock Text="In dieser Sitzung freigegeben" Style="{StaticResource SecondaryText}" />
                        <TextBlock x:Name="FreedText" Style="{StaticResource SubtitleTextBlockStyle}" FontSize="28"
                                   Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                        <TextBlock Text="durch Bereinigung und Löschen" Style="{StaticResource SecondaryText}" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Scan-Leistung" Style="{StaticResource SecondaryText}" />
                        <TextBlock x:Name="CoresText" Style="{StaticResource SubtitleTextBlockStyle}" FontSize="28" />
                        <TextBlock x:Name="AdminText" Style="{StaticResource SecondaryText}" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Schnellaktionen -->
            <TextBlock Text="Schnellaktionen" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,8,0,0" />
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button Tag="cleanup" Click="QuickAction_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="16">
                    <StackPanel Spacing="8">
                        <FontIcon Glyph="&#xEA99;" FontSize="24" HorizontalAlignment="Left" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        <TextBlock Text="Bereinigen" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock Text="Cache, Temp &amp; Papierkorb leeren" Style="{StaticResource SecondaryText}" />
                    </StackPanel>
                </Button>
                <Button Grid.Column="1" Tag="scan" Click="QuickAction_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="16">
                    <StackPanel Spacing="8">
                        <FontIcon Glyph="&#xE721;" FontSize="24" HorizontalAlignment="Left" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        <TextBlock Text="Große Dateien finden" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock Text="Auch versteckte Speicherfresser" Style="{StaticResource SecondaryText}" />
                    </StackPanel>
                </Button>
                <Button Grid.Column="2" Tag="games" Click="QuickAction_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="16">
                    <StackPanel Spacing="8">
                        <FontIcon Glyph="&#xE7FC;" FontSize="24" HorizontalAlignment="Left" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        <TextBlock Text="Spiele" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock Text="Steam, Epic, Xbox, GOG …" Style="{StaticResource SecondaryText}" />
                    </StackPanel>
                </Button>
                <Button Grid.Column="3" Tag="programs" Click="QuickAction_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="16">
                    <StackPanel Spacing="8">
                        <FontIcon Glyph="&#xE71D;" FontSize="24" HorizontalAlignment="Left" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        <TextBlock Text="Programme" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock Text="Größte Programme deinstallieren" Style="{StaticResource SecondaryText}" />
                    </StackPanel>
                </Button>
            </Grid>

            <!-- Laufwerke -->
            <Grid Margin="0,8,0,0">
                <TextBlock Text="Laufwerke" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
                <Button HorizontalAlignment="Right" Click="Refresh_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE72C;" FontSize="14" />
                        <TextBlock Text="Aktualisieren" />
                    </StackPanel>
                </Button>
            </Grid>
            <ItemsControl x:Name="DriveList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:DriveItem">
                        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                            <Grid ColumnSpacing="20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Glyph="{x:Bind Glyph}" FontSize="36" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center">
                                    <Grid>
                                        <TextBlock Text="{x:Bind Title}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                        <TextBlock Text="{x:Bind UsedText}" HorizontalAlignment="Right" Style="{StaticResource SecondaryText}" />
                                    </Grid>
                                    <ProgressBar Value="{x:Bind UsedPercent}" Maximum="100" Height="8" MinHeight="8" CornerRadius="4" ShowError="{x:Bind IsCritical}" />
                                    <Grid>
                                        <TextBlock Text="{x:Bind FreeText}" Style="{StaticResource SecondaryText}" />
                                        <TextBlock Text="{x:Bind Subtitle}" HorizontalAlignment="Right" Style="{StaticResource SecondaryText}" />
                                    </Grid>
                                </StackPanel>
                                <Button Grid.Column="2" Content="Laufwerk scannen" Tag="{x:Bind Root}" Click="ScanDrive_Click" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</Page>
